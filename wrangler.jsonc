{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yaelmusictherapy",
  "account_id": "a4f07f934d59a337ea15d14fb718c602",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [{ "pattern": "yaelmusictherapy.danishdave.com", "custom_domain": true }],
  "preview_urls": false,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": { "bindings": [{ "name": "CONTACTS", "class_name": "ContactsDatabase" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ContactsDatabase"] }],
  "vars": { "INSTANCE_NAME": "yaelmusictherapy-production" },
  "observability": { "enabled": true }
}
